    "verification",
    "e2e",
    "regression-testing",
    "agent-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runzhi214/gui-eyes.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "gui-eyes": "./bin/gui-eyes.js",
    "gui-eyes-mcp": "./bin/gui-eyes-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "scenarios/example-plain.yaml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "REQUIREMENTS.md"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.62.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "pnpm": {
