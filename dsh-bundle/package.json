{
  "name": "@runzhi214/gui-eyes-dsh",
  "version": "0.5.0",
  "type": "module",
  "description": "gui-eyes 的 dsh profile 接入插件: 安装即自动拉取 gui-eyes 引擎本体(dependency),所有新会话获得 mcp__gui-eyes__* 七工具。",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "gui-eyes": "^0.5.0"
  }
}
